<UserControl x:Class="AstroRig.NinaPlugin.RigPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary Source="ReadableControls.xaml" />
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <WrapPanel>
            <Button Content="New inventory" Click="NewInventory" Padding="8,3" Margin="0,0,6,4" />
            <Button Content="Add equipment" Click="AddEquipment" Padding="8,3" Margin="0,0,6,4" />
            <Button Content="Add rig" Click="AddRig" Padding="8,3" Margin="0,0,6,4" />
            <Button Content="Edit rig" Click="EditSelectedRig" Padding="8,3" Margin="0,0,6,4" />
            <Button Content="Assign equipment" Click="AssignEquipment" Padding="8,3" Margin="0,0,6,4" />
            <Button Content="Edit assignment" Click="EditComponent" Padding="8,3" Margin="0,0,6,4" />
            <Button Content="Remove assignment" Click="RemoveComponent" Padding="8,3" Margin="0,0,6,4" />
            <Button Content="Open inventory" Click="OpenInventory" Padding="8,3" Margin="0,0,6,4" />
            <Button Content="Reload" Click="ReloadInventory" Padding="8,3" Margin="0,0,6,4" />
            <Button x:Name="ExportButton" Content="Export Excel" Click="ExportInventory" Padding="8,3" Margin="0,0,6,4" IsEnabled="False" />
            <Button x:Name="SlotsButton" Content="Assign filters to slots" Click="EditSlots" Padding="8,3" Margin="0,0,0,4" IsEnabled="False" />
        </WrapPanel>
        <DockPanel Grid.Row="1" Margin="0,4,0,4">
            <Label Content="Rig" Target="{Binding ElementName=Rigs}" />
            <StackPanel Orientation="Horizontal" Margin="8,0,0,0" DockPanel.Dock="Right">
                <Label Content="Equipment view" Target="{Binding ElementName=EquipmentViewMode}" />
                <ComboBox x:Name="EquipmentViewMode" MinWidth="105" SelectedIndex="0"
                          SelectionChanged="ChangeEquipmentView">
                    <ComboBoxItem Content="Rig order" />
                    <ComboBoxItem Content="Alphabetical" />
                    <ComboBoxItem Content="By type" />
                </ComboBox>
            </StackPanel>
            <ComboBox x:Name="Rigs" DisplayMemberPath="Name" SelectionChanged="ShowRig" />
        </DockPanel>
        <StackPanel Grid.Row="2" Margin="0,4,0,8">
            <CheckBox x:Name="ShowRigCost" Content="Show rig cost" Checked="RigCostChanged" Unchecked="RigCostChanged" />
            <TextBlock x:Name="RigCost" Margin="0,2,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
            <TextBlock x:Name="Summary" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <DataGrid x:Name="Components" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionChanged="SelectComponent"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto" CanUserResizeColumns="True">
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="GroupItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="GroupItem">
                                        <Expander IsExpanded="True" HorizontalContentAlignment="Stretch">
                                            <Expander.Header>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            </Expander.Header>
                                            <ItemsPresenter />
                                        </Expander>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </DataGrid.GroupStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="{TemplateBinding Background}"
                                        TextElement.Foreground="{TemplateBinding Foreground}">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
                        </DataTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Equipment" SortMemberPath="Name" Width="*" MinWidth="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding EquipmentDisplay}" Padding="4,2" TextWrapping="Wrap"
                                       Background="Transparent"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridCell}}"
                                       ToolTipService.ShowDuration="30000">
                                <TextBlock.ToolTip>
                                    <ToolTip Foreground="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}"
                                             Background="{DynamicResource {x:Static SystemColors.InfoBrushKey}}"
                                             BorderBrush="{DynamicResource {x:Static SystemColors.WindowFrameBrushKey}}">
                                        <ToolTip.Template>
                                            <ControlTemplate TargetType="ToolTip">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="1" CornerRadius="3" Padding="8,6">
                                                    <ContentPresenter />
                                                </Border>
                                            </ControlTemplate>
                                        </ToolTip.Template>
                                        <TextBlock MaxWidth="360" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource {x:Static SystemColors.InfoTextBrushKey}}"
                                                   Text="{Binding PlacementTarget.DataContext.EquipmentTooltip, RelativeSource={RelativeSource AncestorType=ToolTip}}" />
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="Auto" MinWidth="85" />
                <DataGridTextColumn Header="Weight (kg / lb)" Binding="{Binding Weight}" SortMemberPath="Item.WeightKg" Width="SizeToHeader" MinWidth="125" />
                <DataGridCheckBoxColumn Header="Payload" Binding="{Binding Payload, Mode=OneWay}" Width="SizeToHeader" MinWidth="60" />
                <DataGridCheckBoxColumn Header="Backfocus" Binding="{Binding Backfocus, Mode=OneWay}" Width="SizeToHeader" MinWidth="70" />
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="Status" Grid.Row="4" Margin="0,8,0,0" TextWrapping="Wrap" />
    </Grid>
</UserControl>
