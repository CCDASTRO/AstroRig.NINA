<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyTitle>AstroRig</AssemblyTitle>
    <Description>Equipment inventory and rig planning inside N.I.N.A.</Description>
    <Company>CCDASTRO</Company>
    <Version>1.0.1</Version>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NINA.Plugin" Version="3.3.0.1069-nightly" PrivateAssets="all" />
    <Using Include="System.IO" />
    <Compile Include="..\EquipmentFields.cs" Link="EquipmentFields.cs" />
    <Compile Include="..\Model.cs" Link="Model.cs" />
    <Compile Include="..\ExcelExport.cs" Link="ExcelExport.cs" />
  </ItemGroup>
</Project>
